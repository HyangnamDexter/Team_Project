# 웹 PACS 자동 실행 설정 (systemd). README "JCloud 배포" 6단계에서 서버에 복사한다.
# 서버가 재부팅되거나 앱이 죽어도 자동으로 다시 켠다.
# 사용자 이름(ubuntu)과 폴더(/home/ubuntu/Team_Project)가 다르면 아래 네 곳을 고친다.
[Unit]
Description=Educational Web PACS (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Team_Project
ExecStart=/home/ubuntu/Team_Project/venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
