# 이 파일을 복사해 .streamlit/secrets.toml 로 만들고 값을 채우세요.
# secrets.toml 은 .gitignore 에 포함되어 커밋되지 않습니다.

[firebase]
web_api_key = "Firebase 콘솔 > 프로젝트 설정 > 웹 API 키"
service_account_path = "서비스 계정 JSON 파일의 로컬 경로 (저장소 밖에 두기)"

[storage]
image_dir = "storage"  # 영상 파일 저장 위치 (JCloud 서버의 영구 디스크 경로)

[model]
path = "models/implant.onnx"  # 임플란트 탐지 모델 (ONNX). 없으면 탐지 없이 등록된다. 저장소에 올리지 않는다
